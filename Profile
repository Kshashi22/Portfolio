<style>
  :root{
    --bg:#08080a;
    --panel:#111114;
    --panel-2:#16161a;
    --line:rgba(255,255,255,0.09);
    --text:#EDEDF0;
    --text-dim:#9A9AA5;
    --violet:#8B7CF6;
    --cyan:#4FD1C5;
    --grad: linear-gradient(120deg, var(--violet), var(--cyan));
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg); color:var(--text);
    font-family:'Space Grotesk', sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  ::selection{background:var(--violet); color:#08080a;}
  a{color:inherit; text-decoration:none;}
  .wrap{max-width:1180px; margin:0 auto; padding:0 32px;}
  .mono{font-family:'JetBrains Mono', monospace;}
  .grad-text{background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent;}

  /* background glow */
  .glow{position:fixed; border-radius:50%; filter:blur(120px); opacity:0.28; z-index:0; pointer-events:none;}
  .glow-1{width:520px; height:520px; background:var(--violet); top:-160px; left:-160px;}
  .glow-2{width:460px; height:460px; background:var(--cyan); top:280px; right:-180px;}

  nav, header, section, footer{position:relative; z-index:1;}

  /* NAV */
  nav{position:sticky; top:0; z-index:50; background:rgba(8,8,10,0.75); backdrop-filter:blur(12px); border-bottom:1px solid var(--line);}
  nav .wrap{display:flex; align-items:center; justify-content:space-between; height:74px;}
  .brand{display:flex; align-items:center; gap:10px; font-weight:600; font-size:1.02rem;}
  .brand .dot{width:8px; height:8px; border-radius:50%; background:var(--cyan); box-shadow:0 0 12px var(--cyan);}
  nav ul{display:none; gap:30px; list-style:none;}
  nav ul li a{font-size:0.85rem; color:var(--text-dim); transition:color .2s;}
  nav ul li a:hover{color:var(--text);}
  .nav-cta{display:none; font-family:'JetBrains Mono', monospace; font-size:0.75rem; border:1px solid var(--line); padding:9px 18px; border-radius:8px;}
  @media(min-width:900px){ nav ul{display:flex;} .nav-cta{display:inline-flex; align-items:center; gap:6px;} }
  .nav-cta:hover{border-color:var(--violet);}

  /* HERO */
  .hero{padding:90px 0 70px;}
  .hero-grid{display:grid; grid-template-columns:1fr; gap:56px; align-items:center;}
  @media(min-width:920px){ .hero-grid{grid-template-columns:1.2fr 0.8fr;} }

  .status{display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono', monospace; font-size:0.72rem; color:var(--text-dim); border:1px solid var(--line); padding:7px 14px; border-radius:999px; margin-bottom:28px;}
  .status .dot{width:7px; height:7px; border-radius:50%; background:#4ADE80; box-shadow:0 0 8px #4ADE80;}

  h1.headline{font-size:clamp(2.4rem,5.4vw,4rem); font-weight:600; line-height:1.08; letter-spacing:-0.02em; margin-bottom:22px;}
  .hero p.lede{font-size:1.05rem; line-height:1.7; color:var(--text-dim); max-width:520px; margin-bottom:34px;}

  .hero-actions{display:flex; flex-wrap:wrap; gap:14px; margin-bottom:46px;}
  .btn{font-family:'JetBrains Mono', monospace; font-size:0.8rem; padding:13px 24px; border-radius:10px; display:inline-flex; align-items:center; gap:8px; transition:transform .2s ease, box-shadow .2s ease;}
  .btn-primary{background:var(--grad); color:#08080a; font-weight:600;}
  .btn-primary:hover{transform:translateY(-2px); box-shadow:0 14px 30px -8px rgba(139,124,246,0.5);}
  .btn-ghost{border:1px solid var(--line); color:var(--text);}
  .btn-ghost:hover{border-color:var(--cyan); transform:translateY(-2px);}

  .stack-row{display:flex; flex-wrap:wrap; gap:10px;}
  .stack-chip{font-family:'JetBrains Mono', monospace; font-size:0.74rem; background:var(--panel); border:1px solid var(--line); padding:7px 14px; border-radius:999px; color:var(--text-dim);}

  /* photo */
  .photo-frame{position:relative; justify-self:center; width:100%; max-width:320px;}
  .ring{position:absolute; inset:-14px; border-radius:28px; background:var(--grad); opacity:0.55; filter:blur(18px); z-index:0;}
  .photo-card{position:relative; z-index:1; border-radius:24px; overflow:hidden; border:1px solid var(--line); background:var(--panel);}
  .photo-card img{width:100%; display:block; aspect-ratio:4/5; object-fit:cover; filter:grayscale(0.1) contrast(1.05);}
  .tag-float{position:absolute; z-index:2; left:-16px; bottom:22px; background:var(--panel-2); border:1px solid var(--line); padding:12px 16px; border-radius:12px; font-family:'JetBrains Mono', monospace; font-size:0.68rem; max-width:170px; box-shadow:0 20px 40px -20px rgba(0,0,0,0.8);}
  .tag-float b{display:block; font-weight:600; font-size:0.85rem; margin-bottom:2px; color:var(--text);}

  /* SECTION generic */
  section{padding:100px 0;}
  .section-head{margin-bottom:52px; max-width:640px;}
  .eyebrow{font-family:'JetBrains Mono', monospace; font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; color:var(--cyan); margin-bottom:18px; display:flex; align-items:center; gap:10px;}
  .eyebrow::before{content:''; width:24px; height:1px; background:var(--cyan);}
  .section-head h2{font-size:clamp(1.85rem,3.3vw,2.6rem); font-weight:600; line-height:1.15;}
  .section-head p{color:var(--text-dim); margin-top:14px; font-size:1rem; line-height:1.6;}

  /* SKILLS */
  .skills-grid{display:grid; grid-template-columns:1fr; gap:1px; background:var(--line); border:1px solid var(--line); border-radius:16px; overflow:hidden;}
  @media(min-width:760px){ .skills-grid{grid-template-columns:repeat(2,1fr);} }
  .skill-card{background:var(--panel); padding:32px; transition:background .25s;}
  .skill-card:hover{background:var(--panel-2);}
  .skill-card .tagnum{font-family:'JetBrains Mono', monospace; font-size:0.75rem; color:var(--cyan);}
  .skill-card h3{font-size:1.2rem; font-weight:600; margin:12px 0 10px;}
  .skill-card p{color:var(--text-dim); font-size:0.9rem; line-height:1.55;}

  /* PROJECT CARDS */
  .proj-grid{display:grid; grid-template-columns:1fr; gap:22px;}
  @media(min-width:720px){ .proj-grid{grid-template-columns:repeat(2,1fr);} }
  @media(min-width:1040px){ .proj-grid{grid-template-columns:repeat(3,1fr);} }
  .proj-card{border:1px solid var(--line); border-radius:16px; overflow:hidden; background:var(--panel); transition:transform .25s ease, border-color .25s ease;}
  .proj-card:hover{transform:translateY(-5px); border-color:rgba(139,124,246,0.5);}
  .proj-head{height:96px; display:flex; align-items:center; padding:0 20px; gap:8px; border-bottom:1px solid var(--line); background:
    repeating-linear-gradient(135deg, rgba(139,124,246,0.06) 0 12px, rgba(79,209,197,0.05) 12px 24px);}
  .proj-head .dot{width:9px; height:9px; border-radius:50%; background:rgba(255,255,255,0.18);}
  .proj-body{padding:22px;}
  .proj-card .tagrow{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px;}
  .tagpill{font-family:'JetBrains Mono', monospace; font-size:0.68rem; background:rgba(139,124,246,0.12); color:var(--violet); padding:4px 10px; border-radius:999px;}
  .tagpill.cyan{background:rgba(79,209,197,0.12); color:var(--cyan);}
  .proj-card h4{font-size:1.08rem; font-weight:600; margin-bottom:8px;}
  .proj-card p{color:var(--text-dim); font-size:0.88rem; line-height:1.5; margin-bottom:16px;}
  .proj-card a.gh{font-family:'JetBrains Mono', monospace; font-size:0.76rem; color:var(--cyan);}
  .proj-card a.gh:hover{text-decoration:underline;}

  /* FLAGSHIP */
  .flagship{border:1px solid var(--line); border-radius:20px; padding:52px; display:grid; grid-template-columns:1fr; gap:40px; background:var(--panel);}
  @media(min-width:900px){ .flagship{grid-template-columns:1fr 1fr; padding:60px;} }
  .flagship .tag{display:inline-block; font-family:'JetBrains Mono', monospace; font-size:0.72rem; background:rgba(139,124,246,0.14); color:var(--violet); padding:6px 14px; border-radius:999px; margin-bottom:18px;}
  .flagship h3{font-size:2rem; font-weight:600; margin-bottom:16px; line-height:1.1;}
  .flagship p{color:var(--text-dim); line-height:1.65; margin-bottom:22px;}
  .flagship .stack{display:flex; flex-wrap:wrap; gap:8px; margin-bottom:26px;}
  .chip{font-family:'JetBrains Mono', monospace; font-size:0.72rem; border:1px solid var(--line); padding:5px 12px; border-radius:6px; color:var(--text-dim);}
  .flagship a.link{font-family:'JetBrains Mono', monospace; font-size:0.85rem; color:var(--cyan); border-bottom:1px solid var(--cyan); padding-bottom:2px;}

  .terminal{background:#000; border:1px solid var(--line); border-radius:14px; padding:26px 24px; font-family:'JetBrains Mono', monospace; font-size:0.82rem;}
  .terminal .bar-dots{display:flex; gap:6px; margin-bottom:18px;}
  .terminal .bar-dots span{width:10px; height:10px; border-radius:50%; background:rgba(255,255,255,0.14);}
  .terminal .line{margin-bottom:8px; color:var(--text-dim);}
  .terminal .k{color:var(--violet);}
  .terminal .metric{color:var(--cyan);}
  .terminal table{width:100%; border-collapse:collapse; margin-top:14px; font-size:0.76rem;}
  .terminal table th, .terminal table td{padding:6px 4px; text-align:left; border-bottom:1px solid var(--line); color:var(--text-dim);}
  .terminal table th{color:var(--violet); font-weight:400;}

  .subgrid-head{font-family:'JetBrains Mono', monospace; font-size:0.75rem; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.06em; margin:44px 0 16px;}
  .nb-wrap{border:1px solid var(--line); border-radius:14px; overflow:hidden; background:var(--panel);}
  .nb-list{display:grid; grid-template-columns:1fr;}
  @media(min-width:700px){ .nb-list{grid-template-columns:repeat(2,1fr);} }
  .nb-item{display:flex; align-items:center; justify-content:space-between; padding:16px 22px; border-top:1px solid var(--line);}
  .nb-list .nb-item:nth-child(-n+2){border-top:none;}
  .nb-item .name{font-family:'JetBrains Mono', monospace; font-size:0.84rem;}
  .nb-item .topic{font-size:0.78rem; color:var(--text-dim);}

  /* PROCESS */
  .process-steps{display:grid; grid-template-columns:1fr; gap:0;}
  @media(min-width:860px){ .process-steps{grid-template-columns:repeat(4,1fr);} }
  .p-step{border-top:1px solid var(--line); padding:24px 0 0;}
  @media(min-width:860px){ .p-step{border-top:none; border-left:1px solid var(--line); padding:0 24px;} .p-step:first-child{padding-left:0; border-left:none;} }
  .p-step .idx{font-family:'JetBrains Mono', monospace; color:var(--violet); font-size:0.85rem; margin-bottom:12px; display:block;}
  .p-step h4{font-size:1.08rem; font-weight:600; margin-bottom:8px;}
  .p-step p{font-size:0.86rem; color:var(--text-dim); line-height:1.5;}

  /* CONTACT */
  .contact{border:1px solid var(--line); border-radius:20px; padding:60px 44px; display:grid; grid-template-columns:1fr; gap:40px; background:
    radial-gradient(circle at top right, rgba(139,124,246,0.12), transparent 60%), var(--panel);}
  @media(min-width:860px){ .contact{grid-template-columns:1.2fr 1fr; padding:70px;} }
  .contact h2{font-size:clamp(2rem,4vw,2.9rem); font-weight:600; line-height:1.1; margin-bottom:18px;}
  .contact p{color:var(--text-dim); line-height:1.6; max-width:440px;}
  .contact-links{display:flex; flex-direction:column; gap:12px;}
  .clink{display:flex; align-items:center; justify-content:space-between; border:1px solid var(--line); border-radius:12px; padding:17px 20px; transition:all .2s; background:rgba(255,255,255,0.02);}
  .clink:hover{border-color:var(--cyan); background:rgba(79,209,197,0.06);}
  .clink .lbl{font-family:'JetBrains Mono', monospace; font-size:0.7rem; text-transform:uppercase; color:var(--text-dim); display:block; margin-bottom:4px;}
  .clink .val{font-size:1.02rem; font-weight:600;}

  footer{border-top:1px solid var(--line); padding:32px 0;}
  footer .wrap{display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; font-size:0.78rem; color:var(--text-dim); font-family:'JetBrains Mono', monospace;}

  @media (prefers-reduced-motion: reduce){ *{transition:none !important;} }
</style>
</head>
