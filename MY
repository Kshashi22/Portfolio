.fade-in.visible {
    opacity: 1;
    transform: translateY(0) scale(1);

}

/* Staggered reveal for grid/list items so cards cascade in rather than popping together */
.cards-grid .fade-in:nth-child(1),
.certificates-grid .fade-in:nth-child(1),
.skills-container .fade-in:nth-child(1),
.blogs-grid .fade-in:nth-child(1),
.articles-list .fade-in:nth-child(1) { transition-delay: 0s; }

