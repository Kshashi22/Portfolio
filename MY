.stats-bar.visible .stat-item {
    animation: statPopIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.stats-bar.visible .stat-item:nth-child(1) { animation-delay: 0.15s; }
.stats-bar.visible .stat-item:nth-child(2) { animation-delay: 0.28s; }
