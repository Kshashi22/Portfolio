.stats-bar.visible .stat-item:nth-child(4) { animation-delay: 0.54s; }

@keyframes statPopIn {
    0% {
        opacity: 0;
        transform: translateY(16px) scale(0.9);
    }
    100% {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

