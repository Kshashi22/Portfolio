    <style>
:root {
    --primary: #9B7EDE;
    --primary-dark: #7C5FC4;
    --secondary: #F0A8C0;
    --accent: #E8A87C;
    --dark: #2D2438;
    --darker: #241C30;
    --light: #3A2E4D;
    --gray: #8B8296;
    --bg: #FDF5F1;
    --bg-soft: #F7EAF2;
    --glass: rgba(255, 255, 255, 0.6);
    --glass-border: rgba(155, 126, 222, 0.25);
    --python-yellow: #ffd43b;
    --python-blue: #306998;
    --gradient-1: linear-gradient(135deg, #9B7EDE, #F0A8C0);
    --gradient-2: linear-gradient(135deg, rgba(155, 126, 222, 0.1), rgba(240, 168, 192, 0.12));
    --gradient-warm: linear-gradient(135deg, #F0A8C0, #E8A87C);
    --success: #5FBF8F;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-snap-type: y proximity;
    scroll-padding-top: 90px;
}

/* Smooth section-to-section scroll transitions:
   each section gently "settles" into place as you scroll past it,
   making the handoff between sections feel continuous rather than abrupt. */
section,
.hero,
footer {
    scroll-snap-align: start;
    scroll-margin-top: 90px;
}

@media (prefers-reduced-motion: reduce) {
    html {
        scroll-behavior: auto;
        scroll-snap-type: none;
    }
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg);
    color: var(--light);
    line-height: 1.7;
    overflow-x: hidden;
}

h1, h2, h3 {
    font-family: 'Playfair Display', 'Inter', serif;
}

#securityPopup {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: #ffffff;
    border: 2px solid var(--primary);
    border-radius: 15px;
    padding: 30px;
    z-index: 99999;
    box-shadow: 0 20px 60px rgba(120, 90, 170, 0.25);
    backdrop-filter: blur(10px);
    width: 90%;
    max-width: 400px;
    text-align: center;
    animation: popupFadeIn 0.3s ease-out;
}

#securityPopup h3 {
    color: var(--dark) !important;
}

#securityPopup p {
    color: var(--gray) !important;
}

#securityPopupOverlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(45, 36, 56, 0.45);
    backdrop-filter: blur(5px);
    z-index: 99998;
    animation: overlayFadeIn 0.3s ease-out;
}

@keyframes popupFadeIn {
    from {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.9);
    }

    to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }
}

@keyframes overlayFadeIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

.background-animation {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background:
        radial-gradient(circle at 15% 20%, rgba(155, 126, 222, 0.16) 0%, transparent 50%),
        radial-gradient(circle at 85% 15%, rgba(240, 168, 192, 0.18) 0%, transparent 50%),
        radial-gradient(circle at 30% 85%, rgba(232, 168, 124, 0.12) 0%, transparent 50%),
        radial-gradient(circle at 90% 80%, rgba(155, 126, 222, 0.12) 0%, transparent 50%),
        var(--bg);
}

.floating-elements {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
}

.floating-element {
    position: absolute;
    border-radius: 50%;
    background: var(--gradient-1);
    opacity: 0.10;
    filter: blur(50px);
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

nav {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 5000;
    padding: 20px 0;
    background: rgba(253, 245, 241, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--glass-border);
    transition: all 0.3s ease;
}

nav.scrolled {
    background: rgba(253, 245, 241, 0.97);
    box-shadow: 0 5px 25px rgba(155, 126, 222, 0.12);
    padding: 15px 0;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-family: 'Playfair Display', serif;
    font-weight: 800;
    font-size: 1.8rem;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-decoration: none;
    z-index: 1001;
}

.nav-links {
    display: flex;
    gap: 22px;
}

.nav-links a {
    color: var(--dark);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    position: relative;
    padding: 5px 0;
    white-space: nowrap;
}

.nav-links a:hover {
    color: var(--primary);
}

.nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gradient-1);
    transition: width 0.3s ease;
}

.nav-links a:hover::after {
    width: 100%;
}

.mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 30px;
    height: 21px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 5001;
}

.mobile-menu-toggle span {
    width: 100%;
    height: 3px;
    background: var(--dark);
    border-radius: 3px;
    transition: all 0.3s ease;
}

.mobile-menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(6px, 6px);
}

.mobile-menu-toggle.active span:nth-child(2) {
    opacity: 0;
}

.mobile-menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(6px, -6px);
}

.mobile-nav {
    position: fixed;
    top: 0;
    right: -100%;
    width: 280px;
    height: 100vh;
    background: rgba(253, 245, 241, 0.98);
    backdrop-filter: blur(10px);
    border-left: 1px solid var(--glass-border);
    padding: 100px 30px 40px;
    z-index: 5000;
    transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    gap: 25px;
    box-shadow: -10px 0 40px rgba(155, 126, 222, 0.1);
    overflow-y: auto;
}

.mobile-nav.active {
    right: 0;
}

.mobile-nav a {
    color: var(--dark);
    text-decoration: none;
    font-size: 1.2rem;
    font-weight: 500;
    padding: 12px 20px;
    border-radius: 10px;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 15px;
}

.mobile-nav a i {
    width: 25px;
    text-align: center;
    color: var(--primary);
}

.mobile-nav a:hover {
    background: rgba(155, 126, 222, 0.12);
    color: var(--primary);
    transform: translateX(5px);
}

.mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(45, 36, 56, 0.35);
    backdrop-filter: blur(3px);
    z-index: 4999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
}

.mobile-overlay.active {
    opacity: 1;
    visibility: visible;
}

.hero {
    padding: 160px 0 100px;
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
}

.hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.hero-text h1 {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 20px;
    color: var(--dark);
}

.hero-text h1 span {
    font-style: italic;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.hero-text p {
    font-size: 1.2rem;
    color: var(--gray);
    margin-bottom: 30px;
    max-width: 90%;
}

.cta-button {
    display: inline-block;
    padding: 15px 30px;
    background: var(--gradient-1);
    color: white;
    text-decoration: none;
    border-radius: 10px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(155, 126, 222, 0.35);
    border: none;
    cursor: pointer;
}

.cta-button:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(155, 126, 222, 0.45);
}

.hero-visual {
    position: relative;
}

.hero-visual::before {
    content: '';
    position: absolute;
    top: -40px;
    left: 50%;
    transform: translateX(-50%);
    width: 88%;
    height: 105%;
    background: linear-gradient(160deg, rgba(155, 126, 222, 0.35), rgba(240, 168, 192, 0.35));
    border-radius: 50% 50% 0 0 / 35% 35% 0 0;
    z-index: -1;
}

.floating-card {
    background: var(--glass);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 30px;
    border: 1px solid var(--glass-border);
    box-shadow: 0 20px 60px rgba(155, 126, 222, 0.2);
    position: relative;
    overflow: hidden;
}

.floating-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 5px;
    background: var(--gradient-1);
}

.card-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.card-content h3 {
    color: var(--dark);
}

.profile-avatar {
    width: 170px;
    height: 170px;
    border-radius: 50%;
    background: var(--gradient-1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border: 5px solid rgba(255, 255, 255, 0.7);
    overflow: hidden;
    transition: all 0.3s ease;
}

.profile-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 80%;
    object-fit: cover;
    transition: all 0.3s ease;
}

.profile-avatar:hover img {
    box-shadow: 30px 20px 20px 5px rgba(155, 126, 222, 0.4);
    transform: scale(1.05);
}

.location-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(155, 126, 222, 0.12);
    padding: 8px 16px;
    border-radius: 30px;
    margin-top: 15px;
    border: 1px solid rgba(155, 126, 222, 0.25);
    color: var(--primary-dark);
}

.scroll-down {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    animation: bounce 2s infinite;
    transition: opacity 0.5s ease, visibility 0.5s ease, transform 0.5s ease;
}

.scroll-down a {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--dark);
    transition: all 0.3s ease;
}

.scroll-down i {
    font-size: 1.8rem;
    margin-bottom: 10px;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.scroll-down span {
    font-size: 0.9rem;
    opacity: 0.7;
}

.scroll-down:hover i {
    transform: translateY(5px);
}

@keyframes bounce {

    0%,
    20%,
    50%,
    80%,
    100% {
        transform: translateX(-50%) translateY(0);
    }

    40% {
        transform: translateX(-50%) translateY(-10px);
    }

    60% {
        transform: translateX(-50%) translateY(-5px);
    }
}

.scroll-to-top {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 50px;
    height: 50px;
    background: var(--gradient-1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.3rem;
    cursor: pointer;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: all 0.4s ease;
    box-shadow: 0 5px 20px rgba(155, 126, 222, 0.35);
    border: none;
}

.scroll-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.scroll-to-top:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(155, 126, 222, 0.45);
}

section {
    padding: 100px 0;
    position: relative;
}

.section-title {
    text-align: center;
    margin-bottom: 60px;
}

.eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 12px;
}

.section-title h2 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 15px;
    color: var(--dark);
}

.section-title p {
    color: var(--gray);
    max-width: 600px;
    margin: 0 auto;
}

/* alternating soft section backdrops */
.certificates,
.journey {
    background: var(--bg-soft);
}

.cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 30px;
}

.glass-card {
    background: var(--glass);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 30px;
    border: 1px solid var(--glass-border);
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
}

.glass-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--gradient-2);
    opacity: 0;
    transition: opacity 0.4s ease;
}

.glass-card:hover::before {
    opacity: 1;
}

.glass-card:hover {
    transform: translateY(-10px);
    border-color: rgba(155, 126, 222, 0.4);
    box-shadow: 0 20px 40px rgba(155, 126, 222, 0.15);
}

.glass-card > * {
    position: relative;
    z-index: 1;
}

.card-icon {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    background: var(--gradient-1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    margin-bottom: 20px;
    color: white;
}

.card-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 15px;
    color: var(--dark);
}

.journey-timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
}

.journey-timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--gradient-1);
    transform: translateX(-50%);
}

.timeline-item {
    display: flex;
    margin-bottom: 50px;
    position: relative;
}

.timeline-item:nth-child(odd) {
    flex-direction: row-reverse;
}

.timeline-content {
    background: var(--glass);
    backdrop-filter: blur(10px);
    border-radius: 15px;
    padding: 25px;
    width: calc(50% - 40px);
    border: 1px solid var(--glass-border);
    position: relative;
    box-shadow: 0 10px 30px rgba(155, 126, 222, 0.08);
}

.timeline-content h3 {
    color: var(--dark) !important;
}

.timeline-item:nth-child(odd) .timeline-content {
    margin-left: 40px;
}

.timeline-item:nth-child(even) .timeline-content {
    margin-right: 40px;
}

.timeline-year {
    position: absolute;
    top: 50%;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--gradient-1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.2rem;
    color: white;
    z-index: 1;
    transform: translateY(-50%);
    box-shadow: 0 10px 30px rgba(155, 126, 222, 0.4);
}

.timeline-item:nth-child(odd) .timeline-year {
    left: calc(50% - 40px);
}

.timeline-item:nth-child(even) .timeline-year {
    right: calc(50% - 40px);
}

/* Skills Section */
.skills-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 30px;
}

.skill-category {
    background: var(--glass);
    backdrop-filter: blur(10px);
    border-radius: 15px;
    padding: 25px;
    border: 1px solid var(--glass-border);
}

.skill-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
}

.skill-header h3 {
    color: var(--dark) !important;
}

.skill-icon {
    width: 50px;
    height: 50px;
    border-radius: 10px;
    background: var(--gradient-1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: white;
}

.skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.skill-item {
    background: rgba(155, 126, 222, 0.1);
    color: var(--dark);
    padding: 8px 15px;
    border-radius: 20px;
    font-size: 0.9rem;
    border: 1px solid rgba(155, 126, 222, 0.25);
    transition: all 0.3s ease;
}

.skill-item:hover {
    background: rgba(155, 126, 222, 0.2);
    transform: translateY(-3px);
}

.skill-item.python {
    background: linear-gradient(135deg, rgba(48, 105, 152, 0.12), rgba(255, 212, 59, 0.18));
    border-color: rgba(48, 105, 152, 0.25);
}

/* Certificates Section */
.certificates-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 30px;
}

.certificate-card {
    background: var(--glass);
    backdrop-filter: blur(10px);
    border-radius: 18px;
    padding: 28px;
    border: 1px solid var(--glass-border);
    transition: all 0.4s ease;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.certificate-card:hover {
    transform: translateY(-8px);
    border-color: rgba(155, 126, 222, 0.4);
    box-shadow: 0 20px 40px rgba(155, 126, 222, 0.15);
}

.certificate-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
}

.certificate-icon {
    width: 55px;
    height: 55px;
    border-radius: 14px;
    background: var(--gradient-warm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    color: white;
    flex-shrink: 0;
}

.certificate-year {
    background: rgba(155, 126, 222, 0.12);
    color: var(--primary-dark);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 20px;
    white-space: nowrap;
}

.certificate-card h3 {
    color: var(--dark);
    font-size: 1.25rem;
    font-weight: 700;
}

.certificate-issuer {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.95rem;
}

.certificate-card p {
    color: var(--gray);
    font-size: 0.95rem;
}

.certificate-link {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
}

.certificate-link:hover {
    color: var(--primary-dark);
}

.why-hire {
    background: var(--bg-soft);
}

/* Research Section */
.research {
    background: linear-gradient(180deg, var(--bg), var(--bg-soft) 50%, var(--bg));
}

.research-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 30px;
}

.research-card {
    background: var(--glass);
    backdrop-filter: blur(10px);
    border-radius: 18px;
    padding: 30px;
    border: 1px solid var(--glass-border);
    transition: all 0.4s ease;
    border-left: 4px solid transparent;
    border-image: var(--gradient-1) 1;
}

.research-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(155, 126, 222, 0.15);
}

.research-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--secondary);
    margin-bottom: 10px;
}

.research-card h3 {
    color: var(--dark);
    font-size: 1.3rem;
    margin-bottom: 12px;
}

.research-card p {
    color: var(--gray);
    margin-bottom: 18px;
}

